{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cafi:v1:envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protected",
    "payload",
    "signatures"
  ],
  "properties": {
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "messageId",
        "messageType",
        "senderId",
        "recipientId",
        "environment",
        "instructionVersion",
        "issuedAt",
        "expiresAt",
        "policyVersion",
        "signatureProfile",
        "canonicalization",
        "signers"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "messageId": {
          "type": "string",
          "format": "uuid"
        },
        "messageType": {
          "enum": [
            "CREATE_OPERATION",
            "QUERY_OPERATION",
            "SUBMIT_INSTRUCTION",
            "QUERY_INSTRUCTION",
            "REGISTER_OPERATION",
            "QUERY_ADMIN_RECORD",
            "CREATE_OPERATION_RESULT",
            "QUERY_OPERATION_RESULT",
            "SUBMIT_INSTRUCTION_RESULT",
            "QUERY_INSTRUCTION_RESULT",
            "REGISTER_OPERATION_RESULT",
            "QUERY_ADMIN_RECORD_RESULT",
            "ERROR"
          ]
        },
        "senderId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "recipientId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "instructionVersion": {
          "type": "integer",
          "const": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 1
        },
        "signatureProfile": {
          "enum": [
            "ECDSA",
            "ML_DSA",
            "DUAL"
          ]
        },
        "canonicalization": {
          "enum": [
            "JCS",
            "EXCLUSIVE_C14N_1_0"
          ]
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "keyId"
            ],
            "properties": {
              "algorithm": {
                "enum": [
                  "ECDSA-P256-SHA256",
                  "ML-DSA-65"
                ]
              },
              "keyId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
              }
            }
          }
        },
        "requestMessageId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "algorithm",
          "keyId",
          "value"
        ],
        "properties": {
          "algorithm": {
            "enum": [
              "ECDSA-P256-SHA256",
              "ML-DSA-65"
            ]
          },
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
          },
          "value": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "CREATE_OPERATION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [],
            "properties": {},
            "not": {
              "required": [
                "operationId"
              ]
            },
            "allOf": [
              {
                "not": {
                  "required": [
                    "requestMessageId"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_OPERATION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId"
            ],
            "properties": {},
            "allOf": [
              {
                "not": {
                  "required": [
                    "requestMessageId"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "SUBMIT_INSTRUCTION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId"
            ],
            "properties": {},
            "allOf": [
              {
                "not": {
                  "required": [
                    "requestMessageId"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_INSTRUCTION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId"
            ],
            "properties": {},
            "allOf": [
              {
                "not": {
                  "required": [
                    "requestMessageId"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "REGISTER_OPERATION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId"
            ],
            "properties": {},
            "allOf": [
              {
                "not": {
                  "required": [
                    "requestMessageId"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_ADMIN_RECORD"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId"
            ],
            "properties": {},
            "allOf": [
              {
                "not": {
                  "required": [
                    "requestMessageId"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "CREATE_OPERATION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId",
              "requestMessageId"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_OPERATION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId",
              "requestMessageId"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "SUBMIT_INSTRUCTION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId",
              "requestMessageId"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_INSTRUCTION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId",
              "requestMessageId"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "REGISTER_OPERATION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId",
              "requestMessageId"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_ADMIN_RECORD_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "operationId",
              "requestMessageId"
            ],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "ERROR"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "protected": {
            "required": [
              "requestMessageId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "CREATE_OPERATION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:cafi:boleta:v1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_OPERATION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/query"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "SUBMIT_INSTRUCTION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/instruction"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_INSTRUCTION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/query"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "REGISTER_OPERATION"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/registration"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_ADMIN_RECORD"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/query"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "CREATE_OPERATION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_OPERATION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "SUBMIT_INSTRUCTION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/receipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_INSTRUCTION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "REGISTER_OPERATION_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "QUERY_ADMIN_RECORD_RESULT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protected": {
            "properties": {
              "messageType": {
                "const": "ERROR"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managerId",
        "boleta",
        "state",
        "sequence"
      ],
      "properties": {
        "managerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "boleta": {
          "$ref": "urn:cafi:boleta:v1"
        },
        "state": {
          "enum": [
            "REGISTERED",
            "VALIDATED",
            "SENT",
            "RECEIVED",
            "ACCEPTED",
            "REJECTED",
            "PENDING_SETTLEMENT",
            "SETTLED",
            "SETTLEMENT_FAILED"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:cafi:v1:event"
          }
        },
        "deliveryStatus": {
          "enum": [
            "PENDING",
            "UNKNOWN",
            "CONFIRMED",
            "BLOCKED"
          ]
        },
        "reconciliationStatus": {
          "enum": [
            "NOT_READY",
            "MATCHED",
            "DIVERGENT"
          ]
        },
        "rejectionOrigin": {
          "enum": [
            "LOCAL",
            "CUSTODIAN"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "REJECTED",
                  "SETTLEMENT_FAILED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "REJECTED"
              }
            }
          },
          "then": {
            "required": [
              "rejectionOrigin"
            ]
          },
          "else": {
            "not": {
              "required": [
                "rejectionOrigin"
              ]
            }
          }
        }
      ]
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managerId",
        "boleta"
      ],
      "properties": {
        "managerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "boleta": {
          "$ref": "urn:cafi:boleta:v1"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managerId",
        "boleta",
        "state",
        "sequence"
      ],
      "properties": {
        "managerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "boleta": {
          "$ref": "urn:cafi:boleta:v1"
        },
        "state": {
          "enum": [
            "REJECTED",
            "SETTLED",
            "SETTLEMENT_FAILED"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rejectionOrigin": {
          "enum": [
            "LOCAL",
            "CUSTODIAN"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "REJECTED",
                  "SETTLEMENT_FAILED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "REJECTED"
              }
            }
          },
          "then": {
            "required": [
              "rejectionOrigin"
            ]
          },
          "else": {
            "not": {
              "required": [
                "rejectionOrigin"
              ]
            }
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "sequence"
      ],
      "properties": {
        "state": {
          "const": "RECEIVED"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "correlationId",
        "retryable",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "issue"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "issue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    }
  }
}
